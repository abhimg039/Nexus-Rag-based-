# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# --- Database (required) ---
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name

# --- App ---
ENVIRONMENT=development

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
# How long Ollama keeps the model in RAM. Keeping it loaded avoids a slow
# cold start (several seconds) on every question.
LLM_KEEP_ALIVE=30m

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
# Load the embedding model at startup instead of on first upload, so the
# first request is not slowed down by model initialisation.
WARM_UP_EMBEDDING_MODEL=true

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Candidates fetched from the vector index before hybrid re-ranking.
RETRIEVAL_CANDIDATE_MULTIPLIER=4
KEYWORD_BOOST=0.08

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
