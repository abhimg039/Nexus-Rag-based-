# Frontend settings. Copy to frontend/.env only if you need to change one — both
# have working defaults, so this file is optional.
#
# Note this is separate from the .env in the project root, which configures the
# backend (database URL, model names). Vite only ever reads this directory.

# Where `npm run dev` proxies /api and /health. Change it if the backend runs on
# a different port or host.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Absolute base URL for API calls in a production build. Leave it unset for the
# normal case, where the built frontend is served from the same origin as the
# API and same-origin relative paths just work. Set it only when the two are
# deployed separately — and remember the backend's CORS settings must then allow
# the frontend's origin.
# VITE_API_BASE_URL=https://api.example.com
